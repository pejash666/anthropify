# hybridstream E2E test configuration.
#
# Copy this file to .env.e2e and fill in real credentials. The .env.e2e
# file is git-ignored; never commit real keys.
#
# Tests guard on the *_API_KEY (or VERTEX_PROJECT) variables: any
# provider whose key is unset is skipped automatically.

# ---- Anthropic ----
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-sonnet-4-5 in helpers/prompts.go.
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---- OpenAI Responses (GPT-5 family) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# ---- Gemini (pick one auth path) ----
# AI Studio key. Leave blank to use Vertex (below).
GEMINI_API_KEY=
# Vertex AI. Only consulted when GEMINI_API_KEY is empty.
VERTEX_PROJECT=
VERTEX_LOCATION=
GEMINI_MODEL=gemini-2.5-flash

# ---- Kimi (OpenAI Chat Completions compatible) ----
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2

# ---- GLM ----
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4.6

# ---- Test control ----
# When true, the E2E harness writes raw SSE bytes to
# testdata/fixtures/recorded/<provider>/<test>.sse for offline replay.
# (Hook is reserved; recording is not yet implemented.)
E2E_RECORD_FIXTURES=false
