# anthropify E2E test configuration.
#
# Copy this file to .env.e2e and fill in real credentials. The .env.e2e
# file is git-ignored; never commit real keys.
#
# Tests guard on the *_API_KEY (or VERTEX_PROJECT) variables: any
# provider whose key is unset is skipped automatically.

# ---- Anthropic ----
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-sonnet-4-5 in helpers/prompts.go.
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---- OpenAI Responses (GPT-5 family) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# ---- Gemini (AI Studio key, generativelanguage.googleapis.com) ----
# The runnable examples standardize on AI Studio for parity with the
# other providers ("one key, one BaseURL, done"). Get a key at
# https://aistudio.google.com/apikey and paste it below.
#
# The recommended default model for the example suite is
# `gemini-3.5-flash` (GA on AI Studio for billing-enabled projects;
# supports thinkingConfig.thinkingLevel and includeThoughts). Any
# Gemini 3.x flash variant works. Pro-series models
# (gemini-3-pro-preview, gemini-3.1-pro-preview) require explicit
# Google preview enrolment and are not the default here.
#
# Vertex AI Bearer/ADC mode is also supported by the adapter (see the
# GeminiMode constants in options.go); leave VERTEX_PROJECT/LOCATION
# blank to keep the examples on AI Studio.
GEMINI_API_KEY=
VERTEX_PROJECT=
VERTEX_LOCATION=
GEMINI_MODEL=gemini-3.5-flash

# ---- Kimi (OpenAI Chat Completions compatible) ----
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.6

# ---- GLM ----
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-5.1

# ---- MiniMax (Anthropic-compatible endpoint) ----
# MiniMax exposes an Anthropic-canonical /v1/messages endpoint that
# anthropify consumes via WithAnthropicCompat("minimax", ...). See
# examples/07-anthropic-compat for the protocol-as-spec demo.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/anthropic
MINIMAX_MODEL=MiniMax-M2.7

# ---- Test control ----
# When true, the E2E harness writes raw SSE bytes to
# testdata/fixtures/recorded/<provider>/<test>.sse for offline replay.
# (Hook is reserved; recording is not yet implemented.)
E2E_RECORD_FIXTURES=false
